// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model PrivateSale {
  id                  Int            @id @default(autoincrement())
  walletAddress       String
  price               String         @default("10M")
  solanaValue         String
  tokenValue          String
  txHash              String         @db.MediumText
  // piWalletAddress String?  @db.MediumText
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  AffiliateUser       AffiliateUser? @relation(fields: [affiliateCode], references: [affiliateCode])
  affiliateCode       String?
  affiliateUserProfit String?
}

model AffiliateUser {
  affiliateCode String        @id @unique @default(uuid())
  walletAddress String        @unique
  createdAt     DateTime      @default(now())
  PrivateSale   PrivateSale[]
}
